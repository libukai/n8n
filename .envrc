# 时区配置
export GENERIC_TIMEZONE=Asia/Shanghai

# SQLite 性能优化 - 启用连接池
export DB_SQLITE_POOL_SIZE=5

# 安全配置 - 允许 Code Node 访问环境变量(如果需要)
# 未来版本默认会改为 true,现在明确设置为 false 保持当前行为
export N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# 安全配置 - 禁用 Git Node 的 bare repository 支持
export N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Task Runners (生产环境推荐启用,开发环境可选)
# 启用后需要配置 Redis,暂时注释
# export N8N_RUNNERS_ENABLED=true
# export N8N_RUNNERS_MODE=external
# export QUEUE_BULL_REDIS_HOST=localhost
# export QUEUE_BULL_REDIS_PORT=6379


# Webhook URL 配置 (请根据实际情况修改)
export N8N_EDITOR_BASE_URL=https://n8n.10k.xyz
export WEBHOOK_URL=http://127.0.0.1:5678/
